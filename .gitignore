# Ignore audio files
*.mp3
*.wav
*.flac
*.ogg
*.aac
*.m4a
*.opus

# Scratch copies, e.g. audio.wav.bak
*.bak

# Python
.venv/
venv/
.env/
__pycache__/
*.pyc
*.pyo
.uv-cache/

# Roblox Specific (rojo lockfiles etc.).
# The blanket *.lock is kept for those, so uv's lockfile is explicitly un-ignored.
*.lock
!uv.lock

# Mac Specific
.DS_Store
